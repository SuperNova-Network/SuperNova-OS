# Copy this file to `.env` and adjust. `.env` is git-ignored; never commit real secrets.

# Port the server listens on.
PORT=3000

# Optional password protection (HTTP Basic auth). Leave AUTH_PASS empty to keep the site public.
# AUTH_USER=admin
# AUTH_PASS=change-me

# Set to 1 to open your browser when the server starts (handy for local development).
# OPEN_BROWSER=1

# Content filter. On by default; CONTENT_FILTER=0 turns it off. BLOCKED_HOSTS adds
# domains (and their subdomains) to the built-in list.
# CONTENT_FILTER=1
# BLOCKED_HOSTS=example.com,games.example.org

# Send browsers to an external Wisp server instead of this one. Needed on hosts that do
# not support WebSockets. Users can still override it in Settings.
# WISP_URL=wss://wisp.example.com/wisp/
