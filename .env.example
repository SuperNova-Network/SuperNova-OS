# Copy this file to `.env` and adjust. `.env` is git-ignored; never commit real secrets.

# Port the server listens on.
PORT=3000

# Optional password protection (HTTP Basic auth). Leave AUTH_PASS empty to keep the site public.
# AUTH_USER=admin
# AUTH_PASS=change-me

# Set to 1 to open your browser when the server starts (handy for local development).
# OPEN_BROWSER=1

# Content filter. On by default; CONTENT_FILTER=0 turns it off. BLOCKED_HOSTS adds
# domains (and their subdomains) to the built-in list.
# CONTENT_FILTER=1
# BLOCKED_HOSTS=example.com,games.example.org

# Accounts: people sign in under Settings > Account and their settings follow them.
# Needs Node.js 22.13+ and a DATA_DIR on storage that survives restarts and deploys.
#   ACCOUNTS=1         optional: sign in from Settings > Account
#   ACCOUNTS=required  the whole site needs an account: a sign-in screen replaces the
#                      AUTH_PASS prompt (AUTH_PASS becomes the invite code)
# ACCOUNTS=1
# Admins (usernames) make invite codes and ban accounts in Settings > Admin, or use
# `npm run admin -- invite` / `ban <name>` on the server.
# ADMINS=your-username
# Who can sign up: invite (needs a code), open (anyone) or 0 (nobody).
# ACCOUNTS_SIGNUP=invite
# A fixed code accepted besides the generated ones (with ACCOUNTS=required, AUTH_PASS is).
# INVITE_CODE=share-this-with-your-class
# DATA_DIR=data

# Behind a reverse proxy (Fly.io, Render, nginx...), trust it for the visitor's address
# and protocol, so rate limits and secure cookies work. A hop count, true, or addresses.
# TRUST_PROXY=1

# Send browsers to an external Wisp server instead of this one. Needed on hosts that do
# not support WebSockets. Users can still override it in Settings.
# WISP_URL=wss://wisp.example.com/wisp/
