# Copy this file to `.env` and adjust. `.env` is git-ignored; never commit real secrets.

# Port the server listens on.
PORT=3000

# Optional password protection (HTTP Basic auth). Leave AUTH_PASS empty to keep the site public.
# AUTH_USER=admin
# AUTH_PASS=change-me

# Set to 1 to open your browser when the server starts (handy for local development).
# OPEN_BROWSER=1

# Content filter. On by default; CONTENT_FILTER=0 turns it off. BLOCKED_HOSTS adds
# domains (and their subdomains) to the built-in list.
# CONTENT_FILTER=1
# BLOCKED_HOSTS=example.com,games.example.org

# Accounts are managed in Settings > Admin (no restart). On the first start the server
# prints a setup link that creates the first admin. They are stored in DATA_DIR, which
# must survive restarts and deploys (Node.js 22.13+).
# DATA_DIR=data
#
# Optional overrides; when set, the admin panel shows the choice as fixed:
# ACCOUNTS=optional            (or required, or off)
# ACCOUNTS_SIGNUP=invite       (or open, or closed)
# ADMINS=your-username         always admins, besides those made admin in the panel
# INVITE_CODE=share-this       a fixed code accepted besides the generated ones
# DATA_DIR=data

# The live chat (it needs accounts) always lets people upload GIFs. For a GIF search
# button too, set a GIPHY API key (free, from developers.giphy.com). The server does
# the searching and relays the pictures, so people's browsers never contact GIPHY.
# GIPHY_API_KEY=your-key

# Behind a reverse proxy (Fly.io, Render, nginx...), trust it for the visitor's address
# and protocol, so rate limits and secure cookies work. A hop count, true, or addresses.
# TRUST_PROXY=1

# Send browsers to an external Wisp server instead of this one. Needed on hosts that do
# not support WebSockets. Users can still override it in Settings.
# WISP_URL=wss://wisp.example.com/wisp/
